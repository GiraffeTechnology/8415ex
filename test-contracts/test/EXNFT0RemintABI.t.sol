pragma solidity 0.8.24;

import {EXNFT0Remint} from "../src/EXNFT0Remint.sol";

// Authored offline ABI fixture only; no contract deployment, signing or chain I/O.
contract EXNFT0RemintABIEncodingTest {
    function testOriginalDeclarationArgumentVector() public pure {
        bytes32[] memory currencies = new bytes32[](2);
        currencies[0] = hex"6666666666666666666666666666666666666666666666666666666666666666";
        currencies[1] = hex"7777777777777777777777777777777777777777777777777777777777777777";
        EXNFT0Remint.Declaration memory replacement = EXNFT0Remint.Declaration(
            hex"3333333333333333333333333333333333333333333333333333333333333333",
            hex"4444444444444444444444444444444444444444444444444444444444444444",
            hex"5555555555555555555555555555555555555555555555555555555555555555", currencies);
        bytes memory expected = hex"";
        bytes memory actual = abi.encode(bytes32(hex"1111111111111111111111111111111111111111111111111111111111111111"),
                                         uint256(7), replacement);
        require(actual.length == 320);
        require(keccak256(actual) == keccak256(expected));
    }
}
